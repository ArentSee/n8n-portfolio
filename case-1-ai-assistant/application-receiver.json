    {
      "parameters": {
        "jsCode": "// Берём текст из Telegram-сообщения\nconst text = $input.item.json.message.text || '';\n\n// Все цифры подряд = телефон\nconst phone = text.replace(/\\D/g, '');\n\n// Все буквы и пробелы = имя \n// (выкидываем цифры, плюсы, дефисы, скобки — пробелы оставляем чтоб \"Иван Петров\" не слипся)\nconst name = text.replace(/[\\d\\+\\-\\(\\)]/g, '')\n                 .replace(/\\s+/g, ' ')  // схлопываем множественные пробелы в один\n                 .trim();                // обрезаем по краям\n\n// === ВАЛИДАЦИЯ ===\n\n// 1. Имя должно быть\nif (!name) {\n  return { json: { valid: false, error: 'не нашёл имя' }};\n}\n\n// 2. Телефон 10-11 цифр (российский формат: 79991234567, 89991234567 или 9991234567)\nif (phone.length < 10 || phone.length > 11) {\n  return { json: { valid: false, error: 'телефон должен быть 10-11 цифр' }};\n}\n\n// === ВСЁ ОК ===\nreturn { json: { valid: true, name, phone }};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        432,
        400
      ],
