        "jsCode": "const rows = $input.all();\n\nlet total = rows.length;\nlet new_count = 0;\nlet in_progress = 0;\nlet rejected = 0;\n\nfor (const row of rows) {\n  const status = row.json[\" status\"];\n  if (status === 'new') new_count++;\n  else if (status === 'take') in_progress++;\n  else if (status === 'rejected') rejected++;\n}\n\nreturn [{\n  json: {\n    total,\n    new: new_count,\n    in_progress,\n    rejected\n  }\n}];"
